# Template for /data/AAP_Storage/secrets/sigmaswap.env
#
# SigmaSwap has NO secrets (no database, no API keys, no wallet keys). This file
# only holds settings. Every key is optional - the defaults are shown.
# Keep the usual perms anyway: 640 root:apache, and restorecon after editing.

# Apache-writable directory OUTSIDE the app tree for the cached pool list.
CACHE_DIR=/data/AAP_Storage/apps/uploads/sigmaswap

# Public base URL. Leave EMPTY so the same checkout serves public.aap and
# private.aap unchanged (it is derived from the request). Set it only if the
# app sits behind a proxy that hides the real host name.
BASE_URL=

# Python interpreter of the app's virtualenv (default: <app dir>/venv/bin/python)
#PYTHON=/data/AAP_Storage/apps/sigmaswap/venv/bin/python

# Data sources
#EXPLORER_URL=https://api.ergoplatform.com
#POOLS_API_URL=https://api.ergodex.io/v1/amm/pools/stats

# Hide pools with less than this much liquidity (USD, as reported by ErgoDex)
#MIN_TVL_USD=100

# Seconds the pool LIST is cached (prices/quotes are always read live)
#POOLS_TTL=180

# Miner fee per swap in nanoERG (0.0011 ERG, same as the ErgoDex web UI)
#MINER_FEE=1100000

# Seconds before a stuck chain helper is killed
#HELPER_TIMEOUT=40
