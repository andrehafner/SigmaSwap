# Template for /etc/sigmaswap/sigmaswap.env
#
# Settings for all five apps (they share this file). Every key is optional - the
# defaults are shown. The secrets are LIGHTHOUSE_API_KEY and SWAPUZ_API_KEY further down.
# Perms: 640 root:www-data (redeploy.sh sets them). No database settings: the apps
# do not use one.

# Directory the web server can write to, OUTSIDE the app tree: the cached pool list, and tx/ with a
# short-lived note per transaction built (so the app can show whether it went through).
# It also holds mint-secret (the key that signs upload sessions). It must NOT be
# reachable over the web: never put it under /usr/lib/cgi-bin or /var/www.
CACHE_DIR=/var/lib/sigmaswap

# Public base URL of the app directory, no trailing slash, e.g.
#   BASE_URL=https://my.ergoport.dev/cgi-bin/sigmaswap
# Set it: signing links are built from it, and it is required when HTTPS ends at a
# proxy in front of Apache. Empty = derived from each request's Host header.
BASE_URL=

# Python interpreter of the app's virtualenv (default: <app dir>/venv/bin/python)
#PYTHON=/usr/lib/cgi-bin/sigmaswap/venv/bin/python

# Data sources
#EXPLORER_URL=https://api.ergoplatform.com
#POOLS_API_URL=https://api.ergodex.io/v1/amm/pools/stats

# Hide pools with less than this much liquidity (USD, as reported by ErgoDex)
#MIN_TVL_USD=100

# Seconds the pool LIST is cached (prices/quotes are always read live)
#POOLS_TTL=180

# Miner fee per swap in nanoERG (0.0011 ERG, same as the ErgoDex web UI)
#MINER_FEE=1100000

# Order mode (ERG pairs): execution fee paid to the ErgoDex bot that executes the
# order, in nanoERG. These are the values the ErgoDex web UI uses; bots may ignore
# orders that offer less. The fee is at least ORDER_MIN_EX_FEE and at most 1.2x that.
#ORDER_MIN_EX_FEE=6000000
# Highest miner fee the bot may spend when executing (it pays it out of its fee)
#ORDER_MINER_FEE=2000000

# Start-screen "Simple mode" switch: 1 = on by default, 0 = off by default.
# Simple mode shows only pay / receive / button and uses 1 % slippage.
#SIMPLE_DEFAULT=0

# Build on top of swaps that are still unconfirmed (lets several swaps on one pool
# land in the same block). Set to 0 to use confirmed blockchain state only.
#USE_MEMPOOL=1

# Where "View transaction" on the status screen points (transaction id is appended)
#EXPLORER_WEB_URL=https://explorer.ergoplatform.com/en/transactions/

# Seconds before a stuck chain helper is killed
#HELPER_TIMEOUT=40

# ---------------------------------------------------------------- order bot ----
# The bot (deploy/sigmaswap-bot.timer) completes orders placed through SigmaSwap,
# which is what makes limit orders fill. 0 = switch it off without removing the timer.
#ORDER_BOT=1
# The same timer checks SigmaStats price alerts once a minute. 0 = off.
#PRICE_ALERTS=1

# ---------------------------------------------------------------- SigmaMint ----
# SECRET. Lighthouse (lighthouse.storage) API key used to store NFT media that
# users add from SigmaMint's "Choose file" step. Leave empty to switch NFT
# minting off (tokens still work).
LIGHTHOUSE_API_KEY=

# Kill switch for uploads without removing the key (0 = off)
#MINT_UPLOADS=1

# Upload limits. Uploads use YOUR Lighthouse storage, so they are capped.
#MINT_MAX_UPLOAD_MB=10
#MINT_UPLOADS_PER_HOUR=10        # per visitor
#MINT_UPLOADS_PER_VISITOR_DAY=30 # per visitor
#MINT_UPLOADS_PER_DAY=300        # everyone together
#MINT_UPLOAD_MB_PER_DAY=1000     # everyone together

#LIGHTHOUSE_UPLOAD_URL=https://upload.lighthouse.storage/api/v0/add
#IPFS_GATEWAY_URL=https://gateway.lighthouse.storage/ipfs
#EXPLORER_TOKEN_URL=https://explorer.ergoplatform.com/en/token/

# --------------------------------------------------------------- SigmaBridge ----
# Rosen bridge. Leave these EMPTY to use the values built into sigmaswap.py. They
# only need setting if Rosen moves to new contracts before the app is updated: a
# wrong lock address sends users' funds to the wrong place, so take new values
# only from Rosen's own release (github.com/rosen-bridge/contract, file
# contracts-ergo-mainnet-*.json: addresses.lock and tokens.MinFeeNFT).
#ROSEN_LOCK_ADDRESS=
#ROSEN_MINFEE_NFT=
#ROSEN_APP_URL=https://app.rosen.tech/events

# SECRET. Swapuz (swapuz.com) partner API key, for SigmaBridge's "Swapuz" option:
# ERG sold for another coin by the Swapuz exchange. Leave empty to switch it off;
# the Rosen bridge is unaffected. The server must reach api.swapuz.com over HTTPS.
SWAPUZ_API_KEY=
