# SigmaSwap order bot - one pass. Install as /etc/systemd/system/sigmaswap-bot.service
#
# Completes swap orders placed through SigmaSwap once the pool can pay their
# minimum (this is what makes limit orders fill). It holds NO keys: completing an
# order is a transaction anyone may send. It runs as the web user, reads the same
# settings file, and only writes to the cache directory.
#
# If your web server runs as a user other than www-data (e.g. apache), change
# User= and Group= below.
[Unit]
Description=SigmaSwap order bot and price alerts (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=APP_ENV_FILE=/etc/sigmaswap/sigmaswap.env
ExecStart=/usr/lib/cgi-bin/sigmaswap/venv/bin/python -I -B /usr/lib/cgi-bin/sigmaswap/sigmaswap.py bot
TimeoutStartSec=50
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
