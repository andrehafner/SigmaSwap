# SigmaSwap order bot - one pass. Install as /etc/systemd/system/sigmaswap-bot.service
#
# Completes swap orders placed through SigmaSwap once the pool can pay their
# minimum (this is what makes limit orders fill). It holds NO keys: completing an
# order is a transaction anyone may send. It runs as the web user, reads the same
# settings file, and only touches the cache directory.
[Unit]
Description=SigmaSwap order bot (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apache
Group=apache
Environment=APP_ENV_FILE=/data/AAP_Storage/secrets/sigmaswap.env
ExecStart=/data/AAP_Storage/apps/sigmaswap/venv/bin/python -I -B /data/AAP_Storage/apps/sigmaswap/sigmaswap.py bot
TimeoutStartSec=50
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
